# ==============================================================================
# INSTAGRAM AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# Meta / Instagram (REQUIRED for basic functionality)
# ------------------------------------------------------------------------------
# Get these from https://developers.facebook.com/apps
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Webhook verification token (can be any random string, set this first)
META_VERIFY_TOKEN=your-random-verify-token-here

# Facebook Page ID connected to your Instagram Business account
META_PAGE_ID=your_page_id_here

# Instagram Business Account ID (RECOMMENDED for production)
# Get from: https://developers.facebook.com/tools/explorer -> Select IG user -> me?fields=id
META_IG_BUSINESS_ID=

# Long-lived Page Access Token (REQUIRED for sending messages)
# Generate at: https://developers.facebook.com/tools/explorer -> Get User Access Token
# Then exchange for long-lived token: https://developers.facebook.com/docs/facebook-login/guides/access-tokens/get-long-lived
META_PAGE_ACCESS_TOKEN=

# Meta Graph API version (use 21.0 or higher)
META_GRAPH_VERSION=21.0

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Define your bot's personality and behavior
BRAND_PERSONA="Friendly, helpful, concise, emoji-friendly"

# Supported languages (comma-separated ISO codes)
LANGS_SUPPORTED="en,hi,mr"

# ------------------------------------------------------------------------------
# Redis (REQUIRED for message queueing)
# ------------------------------------------------------------------------------
# For Docker Compose: redis://redis:6379/0
# For Redis Cloud: redis://username:password@host:port/0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Database (STRONGLY RECOMMENDED for production)
# ------------------------------------------------------------------------------
# PostgreSQL with pgvector extension
# Free options: Neon (https://neon.tech), Supabase (https://supabase.com)
# Format: postgresql://user:password@host:5432/dbname
# After setting this, run migrations/001_init.sql
POSTGRES_URL=

# ------------------------------------------------------------------------------
# LLM Providers (RECOMMENDED for intelligent responses)
# ------------------------------------------------------------------------------
# Choose your LLM provider: groq | ollama | none
LLM_PROVIDER=groq

# Groq (Fast, free tier available: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (Self-hosted: https://ollama.ai)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# Optional: Knowledge Graph (Advanced)
# ------------------------------------------------------------------------------
# Neo4j Aura Free: https://neo4j.com/cloud/aura-free
KG_URI=
KG_USER=
KG_PASSWORD=

# ------------------------------------------------------------------------------
# Optional: Human Handoff via Telegram
# ------------------------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID for receiving handoff notifications
HUMAN_CHAT_ID=

# ------------------------------------------------------------------------------
# Runtime Configuration
# ------------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
